# Server configuration example.
# Copy this file to `server/.env` and replace the placeholder values.
# Never commit a real .env file.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API server listens on
PORT=5000

# Origin allowed by CORS (the running frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign sessions/tokens. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-secret

# MongoDB connection string (Atlas or local). Include credentials.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority

# Logical database name within the MongoDB cluster
MONGODB_DB_NAME=online_leave_management

# First-administrator provisioning (used only by `npm run seed`).
# In production the seed refuses to run unless ADMIN_PASSWORD is set.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.edu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Set to true only in development to also create clearly-marked demo accounts
# (emails under the @demo.local domain). Never enable in production.
SEED_DEMO_DATA=false

# Session / cookie configuration
# Name of the session cookie
SESSION_COOKIE_NAME=olm.sid
# Session lifetime in hours (default: 7 days)
SESSION_TTL_HOURS=168
# Send cookies only over HTTPS (force true in production)
COOKIE_SECURE=false
# Cookie SameSite policy: lax | strict | none. Use `none` (with COOKIE_SECURE=true)
# only when the frontend and API are served from different sites.
COOKIE_SAMESITE=lax

# Express `trust proxy` setting. The API normally sits behind a proxy
# (Vite dev proxy or a production reverse proxy), so this defaults to 1 hop.
# Set to `false` only if the API is exposed directly with no proxy.
TRUST_PROXY=1
