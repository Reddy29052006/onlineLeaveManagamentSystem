# Online Leave Management System — environment variables
#
# This repository uses separate apps, each with its own environment file.
# Copy the matching example file and fill in real values locally:
#
#   Backend:  copy server/.env.example  -> server/.env
#   Frontend: copy client/.env.example  -> client/.env
#
# Never commit real .env files. See server/.env.example and
# client/.env.example for the full list of variables.

# ---- Backend (server/.env) ----
# NODE_ENV=development
# PORT=5000
# CLIENT_ORIGIN=http://localhost:5173
# SESSION_SECRET=replace-with-a-long-random-secret
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
# MONGODB_DB_NAME=online_leave_management

# ---- Frontend (client/.env) ----
# VITE_API_BASE_URL=/api/v1
